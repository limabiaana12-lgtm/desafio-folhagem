import { Request, Response } from "express";
import { Luminosidade } from "@prisma/client";
import * as plantaRepository from "../repositories/PlantaRepository";

// Função auxiliar para validar os dados (serve para POST e PATCH)
const validarDadosPlanta = (data: any, isUpdate: boolean = false) => {
  const { nome, especie, preco, estoque, luminosidade, petFriendly, regaACadaDias } = data;

  if (!isUpdate) {
    if (nome === undefined || especie === undefined || preco === undefined || 
        estoque === undefined || luminosidade === undefined || 
        petFriendly === undefined || regaACadaDias === undefined) {
      return "Todos os campos são obrigatórios no cadastro.";
    }
  }

  if (nome !== undefined && (typeof nome !== "string" || nome.trim() === "")) {
    return "O nome deve ser um texto não vazio.";
  }
  if (especie !== undefined && (typeof especie !== "string" || especie.trim() === "")) {
    return "A espécie deve ser um texto não vazio.";
  }
  if (preco !== undefined && (!Number.isInteger(preco) || preco <= 0)) {
    return "O preço deve ser um número inteiro maior que zero (em centavos).";
  }
  if (estoque !== undefined && (!Number.isInteger(estoque) || estoque < 0)) {
    return "O estoque deve ser um número inteiro maior ou igual a zero.";
  }
  if (regaACadaDias !== undefined && (!Number.isInteger(regaACadaDias) || regaACadaDias < 1)) {
    return "O campo regaACadaDias deve ser um número inteiro de pelo menos 1.";
  }
  if (luminosidade !== undefined && !Object.values(Luminosidade).includes(luminosidade)) {
    return "Luminosidade inválida. Use SOMBRA, MEIA_SOMBRA ou SOL_PLENO.";
  }
  if (petFriendly !== undefined && typeof petFriendly !== "boolean") {
    return "O campo petFriendly deve ser verdadeiro ou falso (boolean).";
  }

  return null; // Retorna null se estiver tudo certo
};

export const createPlanta = async (req: Request, res: Response) => {
  try {
    const erro = validarDadosPlanta(req.body, false);
    if (erro) return res.status(400).json({ message: erro });

    const { nome, especie, preco, estoque, luminosidade, petFriendly, regaACadaDias } = req.body;
    const planta = await plantaRepository.createPlanta({
      nome, especie, preco, estoque, luminosidade, petFriendly, regaACadaDias
    });
    
    return res.status(201).json(planta);
  } catch (error) {
    return res.status(500).json({ message: "Erro interno no servidor." });
  }
};

export const findAllPlantas = async (req: Request, res: Response) => {
  try {
    const { luminosidade, petFriendly } = req.query;
    const where: any = {};

    if (luminosidade !== undefined) {
      if (!Object.values(Luminosidade).includes(luminosidade as Luminosidade)) {
        return res.status(400).json({ message: "Filtro de luminosidade inválido." });
      }
      where.luminosidade = luminosidade;
    }

    if (petFriendly !== undefined) {
      if (petFriendly !== "true" && petFriendly !== "false") {
        return res.status(400).json({ message: "Filtro petFriendly deve ser 'true' ou 'false'." });
      }
      where.petFriendly = petFriendly === "true";
    }

    const plantas = await plantaRepository.findAllPlantas(where);
    return res.status(200).json(plantas);
  } catch (error) {
    return res.status(500).json({ message: "Erro interno no servidor." });
  }
};

export const findPlantaById = async (req: Request, res: Response) => {
  try {
    const id = Number(req.params.id);
    if (!Number.isInteger(id) || id <= 0) {
      return res.status(400).json({ message: "ID inválido." });
    }

    const planta = await plantaRepository.findPlantaById(id);
    if (!planta) return res.status(404).json({ message: "Planta não encontrada." });

    return res.status(200).json(planta);
  } catch (error) {
    return res.status(500).json({ message: "Erro interno no servidor." });
  }
};

export const updatePlanta = async (req: Request, res: Response) => {
  try {
    const id = Number(req.params.id);
    if (!Number.isInteger(id) || id <= 0) {
      return res.status(400).json({ message: "ID inválido." });
    }

    const plantaExiste = await plantaRepository.findPlantaById(id);
    if (!plantaExiste) return res.status(404).json({ message: "Planta não encontrada." });

    const erro = validarDadosPlanta(req.body, true);
    if (erro) return res.status(400).json({ message: erro });

    const { nome, especie, preco, estoque, luminosidade, petFriendly, regaACadaDias } = req.body;
    const plantaAtualizada = await plantaRepository.updatePlanta(id, {
      nome, especie, preco, estoque, luminosidade, petFriendly, regaACadaDias
    });

    return res.status(200).json(plantaAtualizada);
  } catch (error) {
    return res.status(500).json({ message: "Erro interno no servidor." });
  }
};

export const deletePlanta = async (req: Request, res: Response) => {
  try {
    const id = Number(req.params.id);
    if (!Number.isInteger(id) || id <= 0) {
      return res.status(400).json({ message: "ID inválido." });
    }

    const plantaExiste = await plantaRepository.findPlantaById(id);
    if (!plantaExiste) return res.status(404).json({ message: "Planta não encontrada." });

    await plantaRepository.deletePlanta(id);
    return res.status(204).send();
  } catch (error) {
    return res.status(500).json({ message: "Erro interno no servidor." });
  }
};

export const venderPlanta = async (req: Request, res: Response) => {
  try {
    const id = Number(req.params.id);
    const { quantidade } = req.body;

    if (!Number.isInteger(id) || id <= 0) {
      return res.status(400).json({ message: "ID inválido." });
    }
    if (!Number.isInteger(quantidade) || quantidade <= 0) {
      return res.status(400).json({ message: "A quantidade deve ser um número inteiro maior que zero." });
    }

    const planta = await plantaRepository.findPlantaById(id);
    if (!planta) return res.status(404).json({ message: "Planta não encontrada." });

    if (planta.estoque < quantidade) {
      return res.status(400).json({ message: `Estoque insuficiente. Temos só ${planta.estoque} vasos.` });
    }

    const plantaAtualizada = await plantaRepository.venderPlanta(id, quantidade);
    return res.status(200).json(plantaAtualizada);
  } catch (error) {
    return res.status(500).json({ message: "Erro interno no servidor." });
  }
};

export const getValorTotalEstoque = async (req: Request, res: Response) => {
  try {
    const totais = await plantaRepository.getValorTotalEstoque();
    return res.status(200).json(totais);
  } catch (error) {
    return res.status(500).json({ message: "Erro interno no servidor." });
  }
};
